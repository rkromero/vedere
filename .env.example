# ============================================================
# Vedere — variables de entorno
# Copiar a .env (raíz) para api + db, y a apps/web/.env.local para la web.
# En Railway TODAS se cargan como variables del servicio, nunca en el repo.
# ============================================================

# ---------- Base de datos (api, db) ----------
# Local (docker compose): postgresql://vedere:vedere@localhost:5432/vedere
# Railway: referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://vedere:vedere@localhost:5432/vedere?schema=public
# Base separada para los tests de integración de la API (vitest la migra sola). Opcional.
TEST_DATABASE_URL=postgresql://vedere:vedere@localhost:5432/vedere_test?schema=public

# ---------- API ----------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Origen permitido para CORS (la web). En prod: https://www.vedere.com.ar
WEB_URL=http://localhost:3000
# URL pública de la API (se usa para armar URLs de imágenes en modo local)
API_PUBLIC_URL=http://localhost:4000
# Secretos JWT: generar con `openssl rand -base64 48` (distintos entre sí)
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-de-al-menos-32-caracteres
# Duraciones
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookies: en prod cross-site (web y api en dominios distintos) usar SAME_SITE=none y SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Rate limiting (requests por minuto por IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# ---------- Seed (usuario admin inicial) ----------
ADMIN_EMAIL=admin@vedere.com.ar
ADMIN_PASSWORD=cambiar-password-fuerte
ADMIN_NOMBRE=Admin Vedere
# Opcional: crea un usuario OPTICA por óptica socia del seed (optica-<slug>@vedere.com.ar) con esta contraseña (mín. 10).
OPTICA_PASSWORD=

# ---------- Checkout y pagos (prompt 4) ----------
# Mercado Pago (Checkout Pro + webhook + reembolsos). Sin token queda deshabilitado.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENABLED=true
# Minutos que se reserva el stock mientras el cliente paga
RESERVA_STOCK_MINUTOS=30
# Autocompletado de direcciones (opcional)
GOOGLE_MAPS_API_KEY=

# ---------- Ópticas socias y pedidos (prompt 5) ----------
# Emails transaccionales por Resend (estados del pedido al cliente, nuevo pedido a la óptica, avisos al admin).
# Sin RESEND_API_KEY los emails se registran como SIMULADO en emails_enviados (útil en desarrollo y tests).
RESEND_API_KEY=
EMAIL_FROM=Vedere <hola@vedere.com.ar>
# Casilla que recibe los avisos de pedidos sin óptica que los cubra y de solicitudes de cambio/devolución
ADMIN_NOTIFY_EMAIL=
# Cada cuántos minutos se reasignan los pedidos cuyo plazo de aceptación (horas hábiles) venció
ASIGNACION_INTERVALO_MIN=5

# ---------- Cuentas, comunicaciones, marketing y producción (prompt 6) ----------
# Login con Google (OAuth 2.0). En Google Cloud: credencial "Web", redirect URI = <WEB_URL>/api/auth/google/callback.
# Sin credenciales el botón "Continuar con Google" no se muestra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta Conversions API (purchase server side, deduplicado con el Pixel por event_id). TEST_EVENT_CODE sólo para probar.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# GA4 Measurement Protocol (purchase server side, opcional)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Sentry de la API (sin DSN queda apagado)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Jobs: carrito abandonado (cada N minutos) y Plan Rivedere (cada N horas). 0 = apagado.
CARRITO_ABANDONADO_INTERVALO_MIN=15
RIVEDERE_INTERVALO_HORAS=24
# Secreto para disparar jobs desde afuera: POST /jobs/<carrito-abandonado|rivedere|volvio-stock> con header x-cron-secret
CRON_SECRET=

# ---------- Almacenamiento de imágenes ----------
# Driver: auto (R2 si hay credenciales, si no disco local), r2 o local. Local sólo para desarrollo.
STORAGE_DRIVER=auto
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10
# Cloudflare R2 (compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vedere-media
# URL pública del bucket (dominio custom o r2.dev)
R2_PUBLIC_URL=https://media.vedere.com.ar
# Opcional: endpoint S3 alternativo (RustFS de docker-compose en local, servicio `storage` en Railway). Vacío = R2 de la cuenta.
# Local con docker compose: R2_ENDPOINT=http://localhost:9000, R2_PUBLIC_URL=http://localhost:9000/vedere-media, keys vedere/vedere-secret
R2_ENDPOINT=

# ---------- WEB (apps/web/.env.local) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL de la API para el servidor Next (proxy /api/* y server components). Si no está, usa NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
# Barra de promo superior: respaldo cuando el admin no cargó mensajes en /admin/promos
NEXT_PUBLIC_PROMO_ENABLED=true
NEXT_PUBLIC_PROMO_TEXT=Envío gratis y ajuste en tu óptica más cercana
NEXT_PUBLIC_PROMO_LINK=/opticas
# Tienda pública (prompt 3)
NEXT_PUBLIC_WHATSAPP=5491100000000
NEXT_PUBLIC_CUOTAS=6
NEXT_PUBLIC_ENVIO_GRATIS_DESDE=80000
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/vedere
NEXT_PUBLIC_EMAIL_CONTACTO=hola@vedere.com.ar
# Banner de colaboración de la home (opcional)
NEXT_PUBLIC_COLAB_TITULO=
NEXT_PUBLIC_COLAB_TEXTO=
NEXT_PUBLIC_COLAB_LINK=
NEXT_PUBLIC_COLAB_CTA=
# Marketing y producción (prompt 6)
# GTM, GA4 y Meta Pixel: se cargan sólo con consentimiento del banner de cookies. Vacíos = no se cargan.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# true = GA4 en debug_mode (DebugView) y logs de eventos en consola
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# Sentry de la web (navegador + servidor Next). Sin DSN queda apagado.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
