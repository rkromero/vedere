{
  "name": "@vedere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@vedere/db": "workspace:*",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
