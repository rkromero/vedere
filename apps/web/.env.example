# Copiar a apps/web/.env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL de la API para el servidor Next (proxy /api/* y server components)
API_URL=http://localhost:4000

# Barra de promo superior: respaldo cuando el admin no cargó mensajes en /admin/promos
NEXT_PUBLIC_PROMO_ENABLED=true
NEXT_PUBLIC_PROMO_TEXT=Envío gratis y ajuste en tu óptica más cercana
NEXT_PUBLIC_PROMO_LINK=/opticas
# Tienda pública (prompt 3)
NEXT_PUBLIC_WHATSAPP=5491100000000
NEXT_PUBLIC_CUOTAS=6
NEXT_PUBLIC_ENVIO_GRATIS_DESDE=80000
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/vedere
NEXT_PUBLIC_EMAIL_CONTACTO=hola@vedere.com.ar
# Banner de colaboración de la home (opcional)
NEXT_PUBLIC_COLAB_TITULO=
NEXT_PUBLIC_COLAB_TEXTO=
NEXT_PUBLIC_COLAB_LINK=
NEXT_PUBLIC_COLAB_CTA=
