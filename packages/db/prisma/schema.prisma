// Esquema de Vedere. Prompt 1: usuarios y sesiones. Prompt 2: catálogo (marcas, categorías, colecciones, productos, variantes, imágenes).
// Prompt 3: tienda pública (promos, ópticas socias, cupones, newsletter, avisos de stock, contacto, carrito sincronizado).
// Prompt 4: checkout (pedidos, pagos, reservas de stock, recetas), promociones, creadores y configuración de tienda.
// Prompt 5: red de ópticas socias (datos fiscales, radio, capacidad, comisión, usuarios OPTICA), asignación
// automática de pedidos, línea de tiempo de eventos, turnos, solicitudes de cambio, reembolsos y emails.
// B2B 1: precio mayorista y visibilidad por canal, solicitudes de alta de ópticas, varios usuarios por óptica
// (dueño + equipo), contraseña provisoria y auditoría de actualizaciones masivas de precios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Usuarios y sesiones
// ============================================================

enum Rol {
  ADMIN
  OPERADOR
  OPTICA
  CLIENTE
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  nombre                 String
  telefono               String?
  passwordHash           String    @map("password_hash")
  rol                    Rol       @default(CLIENTE)
  activo                 Boolean   @default(true)
  /// Sólo rol OPTICA: óptica socia a la que pertenece el usuario (ve únicamente sus pedidos).
  opticaId               String?   @map("optica_id")
  optica                 Optica?   @relation(fields: [opticaId], references: [id], onDelete: SetNull)
  /// Prompt 6: login con Google (sub de Google), referidos y Plan Rivedere.
  googleId               String?   @unique @map("google_id")
  /// Código único para el link de referidos (/r/<codigo>).
  codigoReferido         String?   @unique @map("codigo_referido")
  referidoPorId          String?   @map("referido_por_id")
  referidoPor            User?     @relation("Referidos", fields: [referidoPorId], references: [id], onDelete: SetNull)
  referidos              User[]    @relation("Referidos")
  /// Primera compra pagada del referido: ya se emitieron los cupones para ambos.
  referidoRecompensadoEn DateTime? @map("referido_recompensado_en")
  /// Último aviso del Plan Rivedere (control de la vista cada 2 años desde la última compra de recetado).
  rivedereAvisadoEn      DateTime? @map("rivedere_avisado_en")
  /// Alta en el newsletter desde la cuenta.
  newsletter             Boolean   @default(false)
  /// B2B: dueño de la óptica (puede dar de alta otros usuarios desde /optica/usuarios).
  opticaDueno            Boolean   @default(false) @map("optica_dueno")
  /// B2B: contraseña provisoria; tiene que cambiarla antes de usar el panel.
  debeCambiarPassword    Boolean   @default(false) @map("debe_cambiar_password")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  refreshTokens    RefreshToken[]
  carrito          Carrito?
  carritoMayorista CarritoMayorista?
  pedidos          Pedido[]
  recetas          Receta[]
  direcciones      Direccion[]
  favoritos        Favorito[]
  passwordResets   PasswordReset[]

  @@index([rol])
  @@index([opticaId])
  @@index([referidoPorId])
  @@map("users")
}

/// Recuperación de contraseña: token opaco de un solo uso (hash sha256), vence a la hora.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usadoEn   DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

/// Direcciones guardadas en la cuenta del cliente (se precargan en el checkout).
model Direccion {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etiqueta       String   @default("Casa")
  direccion      String
  piso           String?
  localidad      String
  provincia      String
  codigoPostal   String   @map("codigo_postal")
  lat            Float?
  lng            Float?
  placeId        String?  @map("place_id")
  telefono       String?
  predeterminada Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("direcciones")
}

/// Favoritos del cliente.
model Favorito {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, productoId])
  @@index([productoId])
  @@map("favoritos")
}

/// Refresh tokens opacos, guardados hasheados (sha256). Se rotan en cada uso.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// Catálogo
// ============================================================

enum Linea {
  SOL
  RECETADO
  MULTIFOCAL
  ACCESORIO
}

enum Forma {
  REDONDO
  CUADRADO
  OJO_DE_GATO
  AVIADOR
  RECTANGULAR
}

enum Genero {
  UNISEX
  MUJER
  HOMBRE
}

enum Material {
  ACETATO
  METAL
  TITANIO
  TR90
  MIXTO
  OTRO
}

enum EstadoProducto {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum TipoImagen {
  FRENTE
  PERFIL
  TRES_CUARTOS
  PUESTO
  OTRA
}

/// Auditoría: createdById / updatedById referencian users.id (sin FK para no acoplar borrados).
model Marca {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  productos Producto[]

  @@map("marcas")
}

model Categoria {
  id          String      @id @default(cuid())
  nombre      String
  slug        String      @unique
  padreId     String?     @map("padre_id")
  padre       Categoria?  @relation("CategoriaArbol", fields: [padreId], references: [id], onDelete: SetNull)
  hijas       Categoria[] @relation("CategoriaArbol")
  orden       Int         @default(0)
  activa      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdById String?     @map("created_by_id")
  updatedById String?     @map("updated_by_id")

  productos Producto[]
  cupones   Cupon[]

  @@index([padreId])
  @@map("categorias")
}

model Coleccion {
  id            String    @id @default(cuid())
  nombre        String
  slug          String    @unique
  colorHex      String    @map("color_hex")
  bannerUrl     String?   @map("banner_url")
  vigenciaDesde DateTime? @map("vigencia_desde")
  vigenciaHasta DateTime? @map("vigencia_hasta")
  activa        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdById   String?   @map("created_by_id")
  updatedById   String?   @map("updated_by_id")

  productos   Producto[]
  cupones     Cupon[]
  promociones Promocion[]

  @@map("colecciones")
}

model Producto {
  id               String         @id @default(cuid())
  nombre           String
  slug             String         @unique
  descripcion      String         @default("")
  marcaId          String?        @map("marca_id")
  marca            Marca?         @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  categorias       Categoria[]
  coleccionId      String?        @map("coleccion_id")
  coleccion        Coleccion?     @relation(fields: [coleccionId], references: [id], onDelete: SetNull)
  linea            Linea
  material         Material?
  forma            Forma?
  genero           Genero         @default(UNISEX)
  calibreMm        Int?           @map("calibre_mm")
  puenteMm         Int?           @map("puente_mm")
  varillaMm        Int?           @map("varilla_mm")
  precio           Decimal        @db.Decimal(12, 2)
  precioLista      Decimal?       @map("precio_lista") @db.Decimal(12, 2)
  /// B2B: precio a ópticas socias, sin IVA. Null = todavía sin precio mayorista. Nunca sale en la tienda.
  precioMayorista  Decimal?       @map("precio_mayorista") @db.Decimal(12, 2)
  /// Visibilidad por canal: tienda web (público) y canal mayorista (ópticas).
  visibleTienda    Boolean        @default(true) @map("visible_tienda")
  visibleMayorista Boolean        @default(true) @map("visible_mayorista")
  permiteReceta    Boolean        @default(false) @map("permite_receta")
  destacado        Boolean        @default(false)
  /// Etiqueta "Edición limitada" en la tienda.
  edicionLimitada  Boolean        @default(false) @map("edicion_limitada")
  estado           EstadoProducto @default(BORRADOR)
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  /// Contador para "más vendidos" (lo actualizan los pedidos).
  vendidos         Int            @default(0)
  publicadoEn      DateTime?      @map("publicado_en")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  createdById      String?        @map("created_by_id")
  updatedById      String?        @map("updated_by_id")

  variantes            Variante[]
  pedidoItems          PedidoItem[]
  pedidoMayoristaItems PedidoMayoristaItem[]

  favoritos Favorito[]

  @@index([estado, linea])
  @@index([estado, visibleTienda])
  @@index([marcaId])
  @@index([coleccionId])
  @@index([precio])
  @@index([vendidos])
  @@index([publicadoEn])
  @@map("productos")
}

model Variante {
  id              String   @id @default(cuid())
  productoId      String   @map("producto_id")
  producto        Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  colorArmazon    String   @map("color_armazon")
  colorArmazonHex String?  @map("color_armazon_hex")
  colorLente      String?  @map("color_lente")
  colorLenteHex   String?  @map("color_lente_hex")
  sku             String   @unique
  stock           Int      @default(0)
  stockMinimo     Int      @default(0) @map("stock_minimo")
  activa          Boolean  @default(true)
  orden           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdById     String?  @map("created_by_id")
  updatedById     String?  @map("updated_by_id")

  imagenes             ImagenVariante[]
  avisosStock          AvisoStock[]
  pedidoItems          PedidoItem[]
  reservas             ReservaStock[]
  pedidoMayoristaItems PedidoMayoristaItem[]

  @@index([productoId])
  @@index([colorArmazon])
  @@map("variantes")
}

/// Imagen de una variante en 3 tamaños (WebP). `url` es la grande.
model ImagenVariante {
  id           String     @id @default(cuid())
  varianteId   String     @map("variante_id")
  variante     Variante   @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  tipo         TipoImagen @default(OTRA)
  orden        Int        @default(0)
  url          String
  urlMediana   String?    @map("url_mediana")
  urlMiniatura String?    @map("url_miniatura")
  alt          String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([varianteId, orden])
  @@map("imagenes_variante")
}

// ============================================================
// Tienda pública (prompt 3)
// ============================================================

/// Mensajes de la barra de promo superior (rotativa). Se editan desde el admin.
model PromoMensaje {
  id            String    @id @default(cuid())
  texto         String
  link          String?
  orden         Int       @default(0)
  activo        Boolean   @default(true)
  vigenciaDesde DateTime? @map("vigencia_desde")
  vigenciaHasta DateTime? @map("vigencia_hasta")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdById   String?   @map("created_by_id")
  updatedById   String?   @map("updated_by_id")

  @@index([activo, orden])
  @@map("promo_mensajes")
}

/// Óptica socia: arma, entrega y ajusta los pedidos cerca del cliente.
/// `nombre` es el nombre comercial; `activa` = activa / pausada (pausada no recibe pedidos nuevos).
model Optica {
  id                       String               @id @default(cuid())
  nombre                   String
  slug                     String               @unique
  razonSocial              String?              @map("razon_social")
  cuit                     String?
  direccion                String
  localidad                String
  provincia                String
  codigoPostal             String               @map("codigo_postal")
  lat                      Float?
  lng                      Float?
  /// Radio de cobertura (km) para la asignación automática.
  radioKm                  Float                @default(10) @map("radio_km")
  telefono                 String?
  whatsapp                 String?
  email                    String?
  horarios                 String?
  /// Óptico técnico responsable y su matrícula.
  opticoResponsable        String?              @map("optico_responsable")
  matricula                String?
  /// B2B: condición frente al IVA y habilitación municipal (archivo en R2).
  condicionIva             CondicionIva?        @map("condicion_iva")
  habilitacionUrl          String?              @map("habilitacion_url")
  /// B2B 2/4: excepción de descuento (%) sobre el precio mayorista. null = el del nivel de la óptica.
  descuentoPct             Decimal?             @map("descuento_pct") @db.Decimal(5, 2)
  /// Compra mínima propia (null = usa la general de ConfigMayorista).
  minimoTipo               TipoMinimoMayorista? @map("minimo_tipo")
  minimoValor              Decimal?             @map("minimo_valor") @db.Decimal(12, 2)
  /// Comisión (%) que cobra la óptica sobre el total de cada pedido entregado.
  comisionPct              Decimal              @default(0) @map("comision_pct") @db.Decimal(5, 2)
  /// Pedidos que puede recibir por día (asignados ese día).
  capacidadDiaria          Int                  @default(20) @map("capacidad_diaria")
  activa                   Boolean              @default(true)
  orden                    Int                  @default(0)
  // B2B 4: niveles. `nivel` es el que resulta del recálculo mensual; `nivelManual` lo pisa hasta su vencimiento.
  nivel                    NivelOptica          @default(VETRO)
  puntaje                  Int?
  nivelDesde               DateTime             @default(now()) @map("nivel_desde")
  nivelCalculadoEn         DateTime?            @map("nivel_calculado_en")
  /// Primer mes (AAAA-MM) en que el puntaje quedó debajo del nivel: arranca la gracia antes de bajar.
  bajaPendienteDesde       String?              @map("baja_pendiente_desde")
  nivelManual              NivelOptica?         @map("nivel_manual")
  nivelManualMotivo        String?              @map("nivel_manual_motivo")
  nivelManualHasta         DateTime?            @map("nivel_manual_hasta")
  nivelManualPorId         String?              @map("nivel_manual_por_id")
  /// Ópticas nuevas: beneficios de otro nivel (Cristallo) por un tiempo.
  beneficioProvisorio      NivelOptica?         @map("beneficio_provisorio")
  beneficioProvisorioHasta DateTime?            @map("beneficio_provisorio_hasta")
  /// Logro Vitrina Vedere: muestrario entregado (lo marca el admin) y fotos de la vitrina (las sube la óptica).
  muestrarioEn             DateTime?            @map("muestrario_en")
  fotosVitrina             String[]             @default([]) @map("fotos_vitrina")
  /// Logro Embajadora: óptica que la refirió.
  referidaPorId            String?              @map("referida_por_id")
  referidaPor              Optica?              @relation("OpticaReferida", fields: [referidaPorId], references: [id], onDelete: SetNull)
  referidas                Optica[]             @relation("OpticaReferida")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  createdById              String?              @map("created_by_id")
  updatedById              String?              @map("updated_by_id")

  historialNiveles       HistorialNivel[]
  logros                 LogroOptica[]
  calificaciones         CalificacionPedido[]
  pedidos                Pedido[]
  usuarios               User[]
  eventos                PedidoEvento[]
  turnos                 Turno[]
  solicitudes            SolicitudOptica[]
  pedidosMayoristas      PedidoMayorista[]
  cuentaCorriente        CuentaCorriente?
  pagosInformados        PagoInformado[]
  devolucionesMayoristas DevolucionMayorista[]

  @@index([activa, provincia])
  @@index([codigoPostal])
  @@map("opticas")
}

enum TipoCupon {
  PORCENTAJE
  MONTO
}

/// Cupón de descuento. Se valida en el carrito y se consume al crear el pedido (CuponUso).
/// Si tiene categorías o colecciones, el descuento se calcula sólo sobre los ítems de ese alcance.
model Cupon {
  id                String      @id @default(cuid())
  codigo            String      @unique
  descripcion       String?
  tipo              TipoCupon
  valor             Decimal     @db.Decimal(12, 2)
  minimoCompra      Decimal?    @map("minimo_compra") @db.Decimal(12, 2)
  usosMax           Int?        @map("usos_max")
  /// Usos máximos por cliente (se cuenta por email).
  usosMaxPorCliente Int?        @map("usos_max_por_cliente")
  usos              Int         @default(0)
  /// Si es false (default) no se combina con otras promos: gana el descuento mayor.
  acumulable        Boolean     @default(false)
  activo            Boolean     @default(true)
  vigenciaDesde     DateTime?   @map("vigencia_desde")
  vigenciaHasta     DateTime?   @map("vigencia_hasta")
  /// Código de creador: el cupón pertenece a un creador y sus ventas se reportan por código.
  creadorId         String?     @map("creador_id")
  creador           Creador?    @relation(fields: [creadorId], references: [id], onDelete: SetNull)
  categorias        Categoria[]
  colecciones       Coleccion[]
  usosRegistro      CuponUso[]
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  createdById       String?     @map("created_by_id")
  updatedById       String?     @map("updated_by_id")

  @@index([creadorId])
  @@map("cupones")
}

model SuscripcionNewsletter {
  id        String    @id @default(cuid())
  email     String    @unique
  nombre    String?
  origen    String?
  /// Token para el link de baja (un click, sin login).
  token     String    @unique @default(cuid())
  bajaEn    DateTime? @map("baja_en")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([bajaEn])
  @@map("suscripciones_newsletter")
}

/// "Avisame cuando vuelva": pedido de aviso por variante sin stock.
model AvisoStock {
  id           String    @id @default(cuid())
  email        String
  varianteId   String    @map("variante_id")
  variante     Variante  @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  notificadoEn DateTime? @map("notificado_en")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([email, varianteId])
  @@index([varianteId])
  @@map("avisos_stock")
}

enum MotivoContacto {
  CONSULTA
  TURNO
  CAMBIO
  ARREPENTIMIENTO
  OPTICA
  OTRO
}

/// Mensajes del formulario de contacto (incluye pedidos de turno multifocal).
model MensajeContacto {
  id        String         @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  motivo    MotivoContacto @default(CONSULTA)
  mensaje   String
  pedido    String?
  leidoEn   DateTime?      @map("leido_en")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([motivo, createdAt])
  @@map("mensajes_contacto")
}

/// Carrito persistido por usuario (se sincroniza con el localStorage del navegador).
model Carrito {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      Json      @default("[]")
  cupon      String?
  /// Carrito abandonado: emails enviados a la hora y a las 24 horas de la última modificación.
  aviso1hEn  DateTime? @map("aviso_1h_en")
  aviso24hEn DateTime? @map("aviso_24h_en")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("carritos")
}

// ============================================================
// Checkout, pagos y promociones (prompt 4)
// ============================================================

/// Creador de contenido con código propio (cupón asociado). Reporte de ventas por código.
model Creador {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique
  instagram   String?
  email       String?
  /// Comisión informativa (% sobre ventas con su código).
  comision    Decimal? @db.Decimal(5, 2)
  activo      Boolean  @default(true)
  cupones     Cupon[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@map("creadores")
}

enum TipoPromocion {
  DOS_POR_UNO
  SEGUNDO_50
  ENVIO_GRATIS
}

/// Regla automática de promoción. Alcance: una línea o una colección (vacío = toda la tienda).
/// Las promos no se acumulan entre sí ni con cupones salvo `acumulable`; el envío gratis es independiente.
model Promocion {
  id            String        @id @default(cuid())
  nombre        String
  tipo          TipoPromocion
  linea         Linea?
  coleccionId   String?       @map("coleccion_id")
  coleccion     Coleccion?    @relation(fields: [coleccionId], references: [id], onDelete: Cascade)
  /// Sólo ENVIO_GRATIS: monto mínimo de compra (después de descuentos).
  montoMinimo   Decimal?      @map("monto_minimo") @db.Decimal(12, 2)
  acumulable    Boolean       @default(false)
  prioridad     Int           @default(0)
  activa        Boolean       @default(true)
  vigenciaDesde DateTime?     @map("vigencia_desde")
  vigenciaHasta DateTime?     @map("vigencia_hasta")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdById   String?       @map("created_by_id")
  updatedById   String?       @map("updated_by_id")

  @@index([activa, tipo])
  @@map("promociones")
}

/// Configuración comercial editable desde el admin (una sola fila, id "default").
model ConfigTienda {
  id                          String   @id @default("default")
  /// Transferencia bancaria
  transferenciaHabilitada     Boolean  @default(true) @map("transferencia_habilitada")
  cbu                         String?
  alias                       String?
  titularCuenta               String?  @map("titular_cuenta")
  banco                       String?
  /// Descuento (%) por pagar con transferencia.
  descuentoTransferencia      Decimal  @default(0) @map("descuento_transferencia") @db.Decimal(5, 2)
  /// Horas que se mantiene reservado el stock de un pedido por transferencia.
  transferenciaHorasReserva   Int      @default(48) @map("transferencia_horas_reserva")
  /// Mercado Pago (además necesita credenciales en el entorno)
  mpHabilitado                Boolean  @default(true) @map("mp_habilitado")
  mpBilleteraHabilitada       Boolean  @default(false) @map("mp_billetera_habilitada")
  /// Cuotas sin interés: general y por línea ({"MULTIFOCAL": 12}).
  cuotasGeneral               Int      @default(6) @map("cuotas_general")
  cuotasPorLinea              Json     @default("{}") @map("cuotas_por_linea")
  /// Envío a domicilio desde la óptica.
  costoEnvio                  Decimal  @default(0) @map("costo_envio") @db.Decimal(12, 2)
  /// Asignación: horas hábiles que tiene la óptica para aceptar antes de pasar a la siguiente.
  plazoAceptacionHoras        Int      @default(4) @map("plazo_aceptacion_horas")
  /// Horario hábil (hora local de Argentina) para contar el plazo. Sábado opcional.
  horaHabilDesde              Int      @default(9) @map("hora_habil_desde")
  horaHabilHasta              Int      @default(18) @map("hora_habil_hasta")
  sabadoHabil                 Boolean  @default(true) @map("sabado_habil")
  /// Prompt 6: datos fiscales (footer y emails).
  razonSocial                 String?  @map("razon_social")
  cuit                        String?
  domicilioFiscal             String?  @map("domicilio_fiscal")
  condicionIva                String?  @map("condicion_iva")
  ingresosBrutos              String?  @map("ingresos_brutos")
  inicioActividades           String?  @map("inicio_actividades")
  emailContacto               String?  @map("email_contacto")
  /// Plan Rivedere: meses desde la última compra de recetado/multifocal y descuento del cupón de recambio.
  rivedereMeses               Int      @default(24) @map("rivedere_meses")
  rivedereDescuentoPct        Decimal  @default(15) @map("rivedere_descuento_pct") @db.Decimal(5, 2)
  /// Referidos: descuento del cupón que reciben el que refiere y el referido cuando el referido compra.
  referidoDescuentoPct        Decimal  @default(10) @map("referido_descuento_pct") @db.Decimal(5, 2)
  /// Carrito abandonado (1 h y 24 h).
  carritoAbandonadoHabilitado Boolean  @default(true) @map("carrito_abandonado_habilitado")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  updatedById                 String?  @map("updated_by_id")

  @@map("config_tienda")
}

enum ModoReceta {
  VALORES
  ARCHIVO
  OPTICA
}

/// Receta óptica: valores cargados, archivo subido o "la mide la óptica". Se guarda en la cuenta.
model Receta {
  id            String     @id @default(cuid())
  userId        String?    @map("user_id")
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  modo          ModoReceta
  odEsfera      Decimal?   @map("od_esfera") @db.Decimal(5, 2)
  odCilindro    Decimal?   @map("od_cilindro") @db.Decimal(5, 2)
  odEje         Int?       @map("od_eje")
  oiEsfera      Decimal?   @map("oi_esfera") @db.Decimal(5, 2)
  oiCilindro    Decimal?   @map("oi_cilindro") @db.Decimal(5, 2)
  oiEje         Int?       @map("oi_eje")
  adicion       Decimal?   @db.Decimal(4, 2)
  /// Distancia pupilar (mm).
  dp            Decimal?   @db.Decimal(4, 1)
  archivoUrl    String?    @map("archivo_url")
  archivoNombre String?    @map("archivo_nombre")
  notas         String?
  createdAt     DateTime   @default(now()) @map("created_at")

  pedidos Pedido[]

  @@index([userId])
  @@map("recetas")
}

/// Ciclo de vida del pedido. Prompt 5: PAGADO (pago aprobado, sin óptica) → ASIGNADO (óptica elegida,
/// pendiente de aceptación) → ACEPTADO → EN_ARMADO → LISTO → ENVIADO (opcional) → ENTREGADO; CANCELADO
/// y DEVUELTO son terminales.
enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  ASIGNADO
  ACEPTADO
  EN_ARMADO
  LISTO
  ENVIADO
  ENTREGADO
  CANCELADO
  DEVUELTO
}

enum CanalPedido {
  WEB
  WHATSAPP
  OPTICA
  ADMIN
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

enum MetodoPago {
  MERCADO_PAGO
  MERCADO_PAGO_BILLETERA
  TRANSFERENCIA
}

enum ModalidadEntrega {
  RETIRO_OPTICA
  ENVIO_DOMICILIO
}

/// Pedido: número legible VD-10001 (secuencia pedidos_numero_seq), ítems con precio congelado,
/// descuentos, receta, óptica asignada, dirección geocodificada, método y estado de pago.
model Pedido {
  id                String           @id @default(cuid())
  numero            String           @unique
  estado            EstadoPedido     @default(PENDIENTE_PAGO)
  userId            String?          @map("user_id")
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Datos de contacto (se guardan aunque haya cuenta: snapshot).
  email             String
  nombre            String
  dni               String
  telefono          String
  /// Entrega
  modalidad         ModalidadEntrega
  opticaId          String?          @map("optica_id")
  optica            Optica?          @relation(fields: [opticaId], references: [id], onDelete: SetNull)
  direccion         String
  piso              String?
  localidad         String
  provincia         String
  codigoPostal      String           @map("codigo_postal")
  lat               Float?
  lng               Float?
  placeId           String?          @map("place_id")
  direccionCompleta String?          @map("direccion_completa")
  /// Receta
  recetaId          String?          @map("receta_id")
  receta            Receta?          @relation(fields: [recetaId], references: [id], onDelete: SetNull)
  /// Importes
  subtotal          Decimal          @db.Decimal(12, 2)
  descuentos        Decimal          @default(0) @db.Decimal(12, 2)
  /// Detalle de descuentos aplicados [{tipo, codigo?, descripcion, monto}].
  descuentosDetalle Json             @default("[]") @map("descuentos_detalle")
  envio             Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  cuponCodigo       String?          @map("cupon_codigo")
  /// Pago
  metodoPago        MetodoPago       @map("metodo_pago")
  estadoPago        EstadoPago       @default(PENDIENTE) @map("estado_pago")
  cuotas            Int              @default(1)
  pagadoEn          DateTime?        @map("pagado_en")
  /// Stock descontado una sola vez (idempotencia del webhook).
  stockDescontado   Boolean          @default(false) @map("stock_descontado")
  reservaExpiraEn   DateTime?        @map("reserva_expira_en")
  numeroFactura     String?          @map("numero_factura")
  notas             String?
  notasInternas     String?          @map("notas_internas")
  /// Prompt 5: canal de origen, asignación a la óptica, logística y comisión.
  canal             CanalPedido      @default(WEB)
  asignadoEn        DateTime?        @map("asignado_en")
  /// Vencimiento del plazo (horas hábiles) para que la óptica acepte; vencido pasa a la siguiente.
  aceptarAntesDe    DateTime?        @map("aceptar_antes_de")
  aceptadoEn        DateTime?        @map("aceptado_en")
  enviadoEn         DateTime?        @map("enviado_en")
  entregadoEn       DateTime?        @map("entregado_en")
  numeroSeguimiento String?          @map("numero_seguimiento")
  /// Ópticas que rechazaron o dejaron vencer este pedido (no se vuelven a proponer).
  opticasExcluidas  String[]         @default([]) @map("opticas_excluidas")
  /// Comisión congelada al asignar (porcentaje de la óptica en ese momento) y monto resultante.
  comisionPct       Decimal?         @map("comision_pct") @db.Decimal(5, 2)
  comisionMonto     Decimal?         @map("comision_monto") @db.Decimal(12, 2)
  /// Total reembolsado al cliente (suma de Reembolso).
  reembolsado       Decimal          @default(0) @db.Decimal(12, 2)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  items        PedidoItem[]
  pagos        Pago[]
  reservas     ReservaStock[]
  cuponUso     CuponUso?
  eventos      PedidoEvento[]
  turnos       Turno[]
  solicitudes  SolicitudCambio[]
  reembolsos   Reembolso[]
  emails       EmailEnviado[]
  calificacion CalificacionPedido?

  @@index([estado, createdAt])
  @@index([estadoPago])
  @@index([userId])
  @@index([email])
  @@index([opticaId])
  @@index([estado, aceptarAntesDe])
  @@index([opticaId, asignadoEn])
  @@map("pedidos")
}

/// Ítem con precio congelado al momento de la compra.
model PedidoItem {
  id             String    @id @default(cuid())
  pedidoId       String    @map("pedido_id")
  pedido         Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId     String?   @map("variante_id")
  variante       Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  productoId     String?   @map("producto_id")
  producto       Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre         String
  sku            String
  color          String
  imagen         String?
  linea          Linea
  precioUnitario Decimal   @map("precio_unitario") @db.Decimal(12, 2)
  precioLista    Decimal?  @map("precio_lista") @db.Decimal(12, 2)
  cantidad       Int
  /// Descuento total de la línea (promos + cupón prorrateado).
  descuento      Decimal   @default(0) @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2)
  conReceta      Boolean   @default(false) @map("con_receta")

  @@index([pedidoId])
  @@index([varianteId])
  @@map("pedido_items")
}

/// Intento de pago. externoId = id del pago en Mercado Pago (único por proveedor → webhook idempotente).
model Pago {
  id                  String     @id @default(cuid())
  pedidoId            String     @map("pedido_id")
  pedido              Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  metodo              MetodoPago
  proveedor           String
  externoId           String?    @map("externo_id")
  preferenciaId       String?    @map("preferencia_id")
  estado              EstadoPago @default(PENDIENTE)
  monto               Decimal    @db.Decimal(12, 2)
  detalle             Json?
  comprobanteUrl      String?    @map("comprobante_url")
  comprobanteNombre   String?    @map("comprobante_nombre")
  comprobanteSubidoEn DateTime?  @map("comprobante_subido_en")
  confirmadoPorId     String?    @map("confirmado_por_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@unique([proveedor, externoId])
  @@index([pedidoId])
  @@map("pagos")
}

enum EstadoReserva {
  ACTIVA
  CONSUMIDA
  LIBERADA
}

/// Reserva de stock mientras se paga (30 min en Mercado Pago; configurable para transferencia).
/// B2B 2: también reserva stock de un pedido mayorista aprobado (pedidoId null, pedidoMayoristaId set).
model ReservaStock {
  id                String           @id @default(cuid())
  pedidoId          String?          @map("pedido_id")
  pedido            Pedido?          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoMayoristaId String?          @map("pedido_mayorista_id")
  pedidoMayorista   PedidoMayorista? @relation(fields: [pedidoMayoristaId], references: [id], onDelete: Cascade)
  varianteId        String           @map("variante_id")
  variante          Variante         @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  cantidad          Int
  estado            EstadoReserva    @default(ACTIVA)
  expiraEn          DateTime         @map("expira_en")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([varianteId, estado])
  @@index([estado, expiraEn])
  @@index([pedidoMayoristaId])
  @@map("reservas_stock")
}

/// Uso de un cupón en un pedido (para límites por cliente y reporte por creador).
model CuponUso {
  id        String   @id @default(cuid())
  cuponId   String   @map("cupon_id")
  cupon     Cupon    @relation(fields: [cuponId], references: [id], onDelete: Cascade)
  pedidoId  String   @unique @map("pedido_id")
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  email     String
  monto     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([cuponId, email])
  @@map("cupon_usos")
}

/// Notificaciones recibidas de proveedores de pago (auditoría e idempotencia por evento).
model EventoWebhook {
  id          String    @id @default(cuid())
  proveedor   String
  eventoId    String    @map("evento_id")
  tipo        String
  payload     Json
  procesadoEn DateTime? @map("procesado_en")
  resultado   String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([proveedor, eventoId])
  @@map("eventos_webhook")
}

// ============================================================
// Ópticas socias y gestión de pedidos (prompt 5)
// ============================================================

enum TipoEventoPedido {
  ESTADO
  ASIGNACION
  RECHAZO
  NOTA
  EMAIL
  PAGO
  REEMBOLSO
  SOLICITUD
}

/// Línea de tiempo del pedido: cada cambio de estado, asignación, nota, email o reembolso,
/// con quién lo hizo (usuario o "sistema") y por qué.
model PedidoEvento {
  id             String           @id @default(cuid())
  pedidoId       String           @map("pedido_id")
  pedido         Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo           TipoEventoPedido
  estadoAnterior EstadoPedido?    @map("estado_anterior")
  estadoNuevo    EstadoPedido?    @map("estado_nuevo")
  opticaId       String?          @map("optica_id")
  optica         Optica?          @relation(fields: [opticaId], references: [id], onDelete: SetNull)
  /// Actor: id de usuario (sin FK para no acoplar borrados), nombre y rol; null = sistema.
  userId         String?          @map("user_id")
  actorNombre    String?          @map("actor_nombre")
  actorRol       Rol?             @map("actor_rol")
  nota           String?
  datos          Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([pedidoId, createdAt])
  @@map("pedido_eventos")
}

enum TipoTurno {
  MEDICION
  AJUSTE
  RETIRO
  OTRO
}

enum EstadoTurno {
  PROGRAMADO
  REALIZADO
  CANCELADO
}

/// Agenda simple de la óptica: turnos de medición y ajuste (sobre todo multifocales).
model Turno {
  id              String      @id @default(cuid())
  opticaId        String      @map("optica_id")
  optica          Optica      @relation(fields: [opticaId], references: [id], onDelete: Cascade)
  pedidoId        String?     @map("pedido_id")
  pedido          Pedido?     @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  tipo            TipoTurno   @default(MEDICION)
  estado          EstadoTurno @default(PROGRAMADO)
  fecha           DateTime
  duracionMin     Int         @default(30) @map("duracion_min")
  clienteNombre   String      @map("cliente_nombre")
  clienteTelefono String?     @map("cliente_telefono")
  notas           String?
  createdById     String?     @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([opticaId, fecha])
  @@index([pedidoId])
  @@map("turnos")
}

enum TipoSolicitud {
  CAMBIO
  DEVOLUCION
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ResolucionSolicitud {
  NUEVO_PEDIDO
  REINTEGRO
}

/// Solicitud de cambio o devolución del cliente; el admin la aprueba (nuevo pedido o reintegro) o rechaza.
model SolicitudCambio {
  id            String               @id @default(cuid())
  pedidoId      String               @map("pedido_id")
  pedido        Pedido               @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo          TipoSolicitud
  motivo        String
  detalle       String?
  estado        EstadoSolicitud      @default(PENDIENTE)
  resolucion    ResolucionSolicitud? @map("resolucion")
  /// Pedido nuevo generado al aprobar un cambio (mismos ítems, sin cargo).
  nuevoPedidoId String?              @map("nuevo_pedido_id")
  respuesta     String?
  resueltoPorId String?              @map("resuelto_por_id")
  resueltoEn    DateTime?            @map("resuelto_en")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([estado, createdAt])
  @@index([pedidoId])
  @@map("solicitudes_cambio")
}

enum EstadoReembolso {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Reembolso (total o parcial) hecho por Mercado Pago o registrado a mano (transferencia).
model Reembolso {
  id          String          @id @default(cuid())
  pedidoId    String          @map("pedido_id")
  pedido      Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pagoId      String?         @map("pago_id")
  proveedor   String
  externoId   String?         @map("externo_id")
  monto       Decimal         @db.Decimal(12, 2)
  motivo      String?
  estado      EstadoReembolso @default(APROBADO)
  detalle     Json?
  creadoPorId String?         @map("creado_por_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([proveedor, externoId])
  @@index([pedidoId])
  @@map("reembolsos")
}

enum EstadoEmail {
  ENVIADO
  SIMULADO
  ERROR
}

/// Registro de cada email transaccional (al cliente, a la óptica o al admin).
model EmailEnviado {
  id        String      @id @default(cuid())
  pedidoId  String?     @map("pedido_id")
  pedido    Pedido?     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo      String
  para      String
  asunto    String
  estado    EstadoEmail
  proveedor String?
  externoId String?     @map("externo_id")
  error     String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([pedidoId, createdAt])
  @@map("emails_enviados")
}

// ============================================================
// Cuentas, comunicaciones, marketing y legal (prompt 6)
// ============================================================

/// Plantilla editable desde el admin para cada email transaccional. El cuerpo admite variables {{nombre}}, {{numero}}, etc.
model PlantillaEmail {
  id          String   @id @default(cuid())
  /// Identificador fijo del email (BIENVENIDA, PEDIDO_CONFIRMADO, ESTADO_PAGADO, ...).
  tipo        String   @unique
  nombre      String
  descripcion String?
  /// Variables disponibles para esta plantilla (documentación para el admin).
  variables   String[] @default([])
  asunto      String
  titulo      String
  cuerpo      String
  ctaLabel    String?  @map("cta_label")
  activa      Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("plantillas_email")
}

enum EstadoArrepentimiento {
  RECIBIDO
  EN_PROCESO
  RESUELTO
  RECHAZADO
}

/// Botón de arrepentimiento (Res. 424/2020): cada solicitud recibe un número de trámite.
model Arrepentimiento {
  id            String                @id @default(cuid())
  numeroTramite String                @unique @map("numero_tramite")
  nombre        String
  email         String
  dni           String?
  telefono      String?
  pedidoNumero  String?               @map("pedido_numero")
  pedidoId      String?               @map("pedido_id")
  motivo        String?
  estado        EstadoArrepentimiento @default(RECIBIDO)
  respuesta     String?
  resueltoEn    DateTime?             @map("resuelto_en")
  resueltoPorId String?               @map("resuelto_por_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([estado, createdAt])
  @@index([email])
  @@map("arrepentimientos")
}

/// Páginas legales editables desde el admin (términos, privacidad, cambios, cookies). Contenido en Markdown.
model PaginaLegal {
  id          String   @id @default(cuid())
  slug        String   @unique
  titulo      String
  intro       String?
  contenido   String
  publicada   Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("paginas_legales")
}

/// Redirecciones 301/302 administrables (URLs viejas → nuevas).
model Redireccion {
  id         String   @id @default(cuid())
  origen     String   @unique
  destino    String
  permanente Boolean  @default(true)
  activa     Boolean  @default(true)
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("redirecciones")
}

// ============================================================
// B2B 1: alta de ópticas y precios mayoristas
// ============================================================

enum CondicionIva {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

enum EstadoSolicitudOptica {
  PENDIENTE
  APROBADA
  RECHAZADA
}

/// Solicitud de alta de una óptica al programa de socias (/opticas/sumate). Al aprobarla se crea o vincula la
/// Optica y un usuario OPTICA dueño con contraseña provisoria.
model SolicitudOptica {
  id                 String                @id @default(cuid())
  razonSocial        String                @map("razon_social")
  nombreComercial    String                @map("nombre_comercial")
  /// CUIT normalizado a 11 dígitos (sin guiones).
  cuit               String
  condicionIva       CondicionIva          @map("condicion_iva")
  direccion          String
  localidad          String
  provincia          String
  codigoPostal       String                @map("codigo_postal")
  telefono           String
  whatsapp           String?
  email              String
  opticoResponsable  String                @map("optico_responsable")
  matricula          String
  habilitacionUrl    String                @map("habilitacion_url")
  habilitacionNombre String?               @map("habilitacion_nombre")
  aceptaTerminosEn   DateTime              @map("acepta_terminos_en")
  ip                 String?
  estado             EstadoSolicitudOptica @default(PENDIENTE)
  motivoRechazo      String?               @map("motivo_rechazo")
  /// Óptica creada o vinculada al aprobar.
  opticaId           String?               @map("optica_id")
  optica             Optica?               @relation(fields: [opticaId], references: [id], onDelete: SetNull)
  /// Usuario OPTICA creado (o existente) al aprobar.
  usuarioId          String?               @map("usuario_id")
  resueltoPorId      String?               @map("resuelto_por_id")
  resueltoEn         DateTime?             @map("resuelto_en")
  /// B2B 4: CUIT de la óptica socia que la recomendó (logro Embajadora).
  referidaPorCuit    String?               @map("referida_por_cuit")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([estado, createdAt])
  @@index([cuit])
  @@map("solicitudes_optica")
}

enum CampoPrecio {
  PRECIO
  PRECIO_MAYORISTA
}

enum AlcancePrecio {
  TODOS
  CATEGORIA
  MARCA
  COLECCION
}

/// Auditoría de las actualizaciones masivas de precios por porcentaje (quién, cuándo, alcance y antes/después).
model ActualizacionPrecio {
  id                 String        @id @default(cuid())
  campo              CampoPrecio
  porcentaje         Decimal       @db.Decimal(7, 2)
  alcance            AlcancePrecio
  alcanceId          String?       @map("alcance_id")
  alcanceNombre      String?       @map("alcance_nombre")
  productosAfectados Int           @map("productos_afectados")
  /// [{ id, nombre, antes, despues }]
  detalle            Json
  usuarioId          String?       @map("usuario_id")
  usuarioNombre      String?       @map("usuario_nombre")
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("actualizaciones_precio")
}

// ============================================================
// B2B 2: catálogo y pedidos mayoristas (portal de la óptica)
// ============================================================

enum TipoMinimoMayorista {
  NINGUNO
  UNIDADES
  MONTO
}

enum EnvioMayoristaModo {
  /// Costo fijo que se suma al pedido.
  COSTO_FIJO
  /// El transporte lo paga la óptica al recibir (no se suma).
  A_CARGO_OPTICA
}

enum EntregaMayorista {
  ENVIO_TRANSPORTE
  RETIRO_DEPOSITO
}

/// Separado de EstadoPedido: el canal mayorista no pasa por pago online ni por asignación a ópticas.
/// PENDIENTE_APROBACION -> APROBADO (reserva stock) -> DESPACHADO (descuenta stock) -> ENTREGADO; CANCELADO es terminal.
enum EstadoPedidoMayorista {
  PENDIENTE_APROBACION
  /// B2B 3: supera el crédito disponible o tiene deuda vencida: decide el admin.
  EN_REVISION
  APROBADO
  EN_PREPARACION
  LISTO_PARA_RETIRO
  DESPACHADO
  ENTREGADO
  CANCELADO
}

/// Configuración del canal mayorista (una sola fila, id "default").
model ConfigMayorista {
  id                    String              @id @default("default")
  ivaPct                Decimal             @default(21) @map("iva_pct") @db.Decimal(5, 2)
  minimoTipo            TipoMinimoMayorista @default(NINGUNO) @map("minimo_tipo")
  minimoValor           Decimal             @default(0) @map("minimo_valor") @db.Decimal(12, 2)
  envioHabilitado       Boolean             @default(true) @map("envio_habilitado")
  envioModo             EnvioMayoristaModo  @default(A_CARGO_OPTICA) @map("envio_modo")
  envioCosto            Decimal             @default(0) @map("envio_costo") @db.Decimal(12, 2)
  retiroHabilitado      Boolean             @default(true) @map("retiro_habilitado")
  retiroDireccion       String?             @map("retiro_direccion")
  retiroHorario         String?             @map("retiro_horario")
  /// B2B 3: días de deuda vencida tolerados antes de mandar un pedido a revisión.
  diasToleranciaVencida Int                 @default(7) @map("dias_tolerancia_vencida")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  updatedById           String?             @map("updated_by_id")

  @@map("config_mayorista")
}

/// Carrito del portal de la óptica (por usuario). Independiente del carrito de la tienda.
model CarritoMayorista {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{varianteId, cantidad}]
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carritos_mayoristas")
}

/// Pedido mayorista: número VM-10001 (secuencia pedidos_mayoristas_numero_seq), precios congelados sin IVA.
model PedidoMayorista {
  id                    String                @id @default(cuid())
  numero                String                @unique
  estado                EstadoPedidoMayorista @default(PENDIENTE_APROBACION)
  opticaId              String                @map("optica_id")
  optica                Optica                @relation(fields: [opticaId], references: [id], onDelete: Restrict)
  usuarioId             String?               @map("usuario_id")
  usuarioNombre         String                @map("usuario_nombre")
  usuarioEmail          String                @map("usuario_email")
  entrega               EntregaMayorista
  /// Snapshot de la dirección de envío o del depósito de retiro.
  direccionEntrega      String                @map("direccion_entrega")
  envioACargoOptica     Boolean               @default(false) @map("envio_a_cargo_optica")
  unidades              Int
  /// Suma a precio mayorista de lista (sin IVA), antes del descuento.
  subtotalLista         Decimal               @map("subtotal_lista") @db.Decimal(12, 2)
  descuentoPct          Decimal               @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  descuento             Decimal               @default(0) @db.Decimal(12, 2)
  /// Neto sin IVA (después del descuento).
  subtotal              Decimal               @db.Decimal(12, 2)
  envio                 Decimal               @default(0) @db.Decimal(12, 2)
  ivaPct                Decimal               @map("iva_pct") @db.Decimal(5, 2)
  iva                   Decimal               @db.Decimal(12, 2)
  total                 Decimal               @db.Decimal(12, 2)
  notas                 String?
  notasInternas         String?               @map("notas_internas")
  motivoCancelacion     String?               @map("motivo_cancelacion")
  /// Pedido del que se repitió (si vino de "Repetir pedido").
  repetidoDeId          String?               @map("repetido_de_id")
  aprobadoEn            DateTime?             @map("aprobado_en")
  aprobadoPorId         String?               @map("aprobado_por_id")
  despachadoEn          DateTime?             @map("despachado_en")
  entregadoEn           DateTime?             @map("entregado_en")
  canceladoEn           DateTime?             @map("cancelado_en")
  numeroSeguimiento     String?               @map("numero_seguimiento")
  stockDescontado       Boolean               @default(false) @map("stock_descontado")
  // B2B 3: cuenta corriente y gestión.
  /// Plazo de pago vigente al confirmar la compra (snapshot de la cuenta corriente).
  plazoPagoDias         Int?                  @map("plazo_pago_dias")
  /// Vencimiento del débito: fecha de despacho (o de listo para retirar) + plazo.
  venceEn               DateTime?             @map("vence_en")
  motivoRevision        String?               @map("motivo_revision")
  enPreparacionEn       DateTime?             @map("en_preparacion_en")
  listoParaRetiroEn     DateTime?             @map("listo_para_retiro_en")
  transporte            String?
  linkSeguimiento       String?               @map("link_seguimiento")
  numeroRemito          Int?                  @unique @map("numero_remito")
  numeroFactura         String?               @map("numero_factura")
  recordatorioPrevioEn  DateTime?             @map("recordatorio_previo_en")
  recordatorioVencidoEn DateTime?             @map("recordatorio_vencido_en")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  items        PedidoMayoristaItem[]
  reservas     ReservaStock[]
  eventos      EventoPedidoMayorista[]
  imputaciones ImputacionPago[]
  movimientos  MovimientoCuenta[]
  devoluciones DevolucionMayorista[]

  @@index([opticaId, createdAt])
  @@index([estado, createdAt])
  @@map("pedidos_mayoristas")
}

model PedidoMayoristaItem {
  id              String          @id @default(cuid())
  pedidoId        String          @map("pedido_id")
  pedido          PedidoMayorista @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  varianteId      String?         @map("variante_id")
  variante        Variante?       @relation(fields: [varianteId], references: [id], onDelete: SetNull)
  productoId      String?         @map("producto_id")
  producto        Producto?       @relation(fields: [productoId], references: [id], onDelete: SetNull)
  nombre          String
  sku             String
  color           String
  imagen          String?
  /// Precio mayorista de lista (sin IVA) y precio con el descuento de la óptica, congelados.
  precioMayorista Decimal         @map("precio_mayorista") @db.Decimal(12, 2)
  descuentoPct    Decimal         @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  precioUnitario  Decimal         @map("precio_unitario") @db.Decimal(12, 2)
  /// Precio sugerido al público (precio web) al momento del pedido.
  precioPublico   Decimal?        @map("precio_publico") @db.Decimal(12, 2)
  cantidad        Int
  total           Decimal         @db.Decimal(12, 2)

  devolucionItems DevolucionMayoristaItem[]

  @@index([pedidoId])
  @@index([varianteId])
  @@map("pedido_mayorista_items")
}

// ------------------------------------------------------------------
// B2B 3: cuenta corriente de las ópticas
// ------------------------------------------------------------------

/// Límite de crédito y plazo de pago por óptica (en B2B 4 los define el nivel). El saldo NO se guarda:
/// siempre es la suma de los movimientos.
model CuentaCorriente {
  id            String   @id @default(cuid())
  opticaId      String   @unique @map("optica_id")
  optica        Optica   @relation(fields: [opticaId], references: [id], onDelete: Cascade)
  /// B2B 4: excepciones por óptica; null = los del nivel.
  limiteCredito Decimal? @map("limite_credito") @db.Decimal(12, 2)
  plazoPagoDias Int?     @map("plazo_pago_dias")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  movimientos MovimientoCuenta[]

  @@map("cuentas_corrientes")
}

enum TipoMovimientoCuenta {
  DEBITO_PEDIDO
  PAGO
  NOTA_CREDITO
  CREDITO_LIQUIDACION
  AJUSTE
}

enum MedioPagoCuenta {
  TRANSFERENCIA
  ECHEQ
  EFECTIVO
}

/// importe con signo: positivo aumenta la deuda de la óptica (débito), negativo la reduce (crédito).
model MovimientoCuenta {
  id                String               @id @default(cuid())
  cuentaId          String               @map("cuenta_id")
  cuenta            CuentaCorriente      @relation(fields: [cuentaId], references: [id], onDelete: Restrict)
  tipo              TipoMovimientoCuenta
  importe           Decimal              @db.Decimal(12, 2)
  fecha             DateTime             @default(now())
  descripcion       String
  /// Obligatorio en AJUSTE.
  motivo            String?
  medio             MedioPagoCuenta?
  referencia        String?
  comprobanteUrl    String?              @map("comprobante_url")
  pedidoMayoristaId String?              @map("pedido_mayorista_id")
  pedidoMayorista   PedidoMayorista?     @relation(fields: [pedidoMayoristaId], references: [id], onDelete: Restrict)
  devolucionId      String?              @map("devolucion_id")
  liquidacionMes    String?              @map("liquidacion_mes")
  /// Sólo en DEBITO_PEDIDO.
  vencimiento       DateTime?
  /// Evita duplicados (débito por pedido, crédito por liquidación, NC por devolución).
  clave             String?              @unique
  creadoPorId       String?              @map("creado_por_id")
  creadoPorNombre   String?              @map("creado_por_nombre")
  createdAt         DateTime             @default(now()) @map("created_at")

  imputaciones  ImputacionPago[]
  pagoInformado PagoInformado?

  @@index([cuentaId, fecha])
  @@index([tipo, fecha])
  @@map("movimientos_cuenta")
}

/// Parte de un crédito (pago, nota de crédito, liquidación o ajuste) aplicada a un pedido despachado.
model ImputacionPago {
  id           String           @id @default(cuid())
  movimientoId String           @map("movimiento_id")
  movimiento   MovimientoCuenta @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  pedidoId     String           @map("pedido_id")
  pedido       PedidoMayorista  @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  monto        Decimal          @db.Decimal(12, 2)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([movimientoId])
  @@index([pedidoId])
  @@map("imputaciones_pago")
}

enum EstadoPagoInformado {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

/// Pago que informa la óptica con su comprobante; no mueve la cuenta hasta que el admin lo valida.
model PagoInformado {
  id                String              @id @default(cuid())
  opticaId          String              @map("optica_id")
  optica            Optica              @relation(fields: [opticaId], references: [id], onDelete: Restrict)
  usuarioId         String?             @map("usuario_id")
  usuarioNombre     String              @map("usuario_nombre")
  importe           Decimal             @db.Decimal(12, 2)
  medio             MedioPagoCuenta
  fechaPago         DateTime            @map("fecha_pago")
  referencia        String?
  comprobanteUrl    String              @map("comprobante_url")
  comprobanteNombre String?             @map("comprobante_nombre")
  notas             String?
  /// Pedidos que la óptica dice pagar (sugerencia para la imputación).
  pedidoIds         String[]            @map("pedido_ids")
  estado            EstadoPagoInformado @default(PENDIENTE)
  motivoRechazo     String?             @map("motivo_rechazo")
  movimientoId      String?             @unique @map("movimiento_id")
  movimiento        MovimientoCuenta?   @relation(fields: [movimientoId], references: [id], onDelete: SetNull)
  revisadoPorId     String?             @map("revisado_por_id")
  revisadoEn        DateTime?           @map("revisado_en")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([estado, createdAt])
  @@index([opticaId, createdAt])
  @@map("pagos_informados")
}

/// Línea de tiempo del pedido mayorista (cambios de estado, notas, factura, pagos, devoluciones).
model EventoPedidoMayorista {
  id            String                 @id @default(cuid())
  pedidoId      String                 @map("pedido_id")
  pedido        PedidoMayorista        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo          String
  estado        EstadoPedidoMayorista?
  nota          String?
  /// Sólo lo ve el staff.
  interno       Boolean                @default(false)
  usuarioId     String?                @map("usuario_id")
  usuarioNombre String?                @map("usuario_nombre")
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([pedidoId, createdAt])
  @@map("eventos_pedido_mayorista")
}

enum EstadoDevolucionMayorista {
  SOLICITADA
  APROBADA
  RECHAZADA
}

model DevolucionMayorista {
  id            String                    @id @default(cuid())
  pedidoId      String                    @map("pedido_id")
  pedido        PedidoMayorista           @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  opticaId      String                    @map("optica_id")
  optica        Optica                    @relation(fields: [opticaId], references: [id], onDelete: Restrict)
  estado        EstadoDevolucionMayorista @default(SOLICITADA)
  motivo        String
  fotos         String[]
  usuarioId     String?                   @map("usuario_id")
  usuarioNombre String                    @map("usuario_nombre")
  /// Importe de la nota de crédito (con IVA).
  importe       Decimal                   @db.Decimal(12, 2)
  motivoRechazo String?                   @map("motivo_rechazo")
  resueltoPorId String?                   @map("resuelto_por_id")
  resueltoEn    DateTime?                 @map("resuelto_en")
  createdAt     DateTime                  @default(now()) @map("created_at")

  items DevolucionMayoristaItem[]

  @@index([estado, createdAt])
  @@index([pedidoId])
  @@map("devoluciones_mayoristas")
}

model DevolucionMayoristaItem {
  id           String              @id @default(cuid())
  devolucionId String              @map("devolucion_id")
  devolucion   DevolucionMayorista @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  pedidoItemId String              @map("pedido_item_id")
  pedidoItem   PedidoMayoristaItem @relation(fields: [pedidoItemId], references: [id], onDelete: Restrict)
  cantidad     Int
  /// Neto sin IVA (precio unitario congelado × cantidad).
  total        Decimal             @db.Decimal(12, 2)

  @@index([devolucionId])
  @@map("devolucion_mayorista_items")
}

/// Cierre de la liquidación mensual de pedidos web: acredita la comisión en la cuenta de cada óptica.
model LiquidacionCierre {
  id              String   @id @default(cuid())
  mes             String   @unique
  total           Decimal  @db.Decimal(12, 2)
  cantidadOpticas Int      @map("cantidad_opticas")
  cerradoPorId    String?  @map("cerrado_por_id")
  cerradoEn       DateTime @default(now()) @map("cerrado_en")

  @@map("liquidaciones_cierre")
}

// ------------------------------------------------------------------
// B2B 4: niveles y logros de las ópticas socias
// ------------------------------------------------------------------

enum NivelOptica {
  VETRO
  CRISTALLO
  PRISMA
  ZAFIRO
}

enum TipoLogro {
  PRIMER_FOCO
  MANO_FIRME
  MULTIFOCAL_MAESTRO
  RELOJITO
  VITRINA_VEDERE
  EMBAJADORA
}

/// Configuración de niveles (fila única id = "default"): cortes, rangos, pesos, ponderación por línea,
/// beneficios por nivel y puntos de logros. Los valores por defecto viven en apps/api/src/lib/niveles.ts.
model ConfigNiveles {
  id        String   @id @default("default")
  datos     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("config_niveles")
}

/// Foto mensual del nivel y del puntaje de cada óptica.
model HistorialNivel {
  id             String       @id @default(cuid())
  opticaId       String       @map("optica_id")
  optica         Optica       @relation(fields: [opticaId], references: [id], onDelete: Cascade)
  /// AAAA-MM
  mes            String
  puntaje        Int
  puntosExtra    Int          @default(0) @map("puntos_extra")
  nivelCalculado NivelOptica  @map("nivel_calculado")
  nivel          NivelOptica
  nivelAnterior  NivelOptica? @map("nivel_anterior")
  motivo         String?
  detalle        Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([opticaId, mes])
  @@index([mes])
  @@map("historial_niveles")
}

model LogroOptica {
  id         String    @id @default(cuid())
  opticaId   String    @map("optica_id")
  optica     Optica    @relation(fields: [opticaId], references: [id], onDelete: Cascade)
  logro      TipoLogro
  puntos     Int
  obtenidoEn DateTime  @default(now()) @map("obtenido_en")

  @@unique([opticaId, logro])
  @@map("logros_opticas")
}

/// Calificación del cliente (1 a 5) a un pedido web entregado: alimenta la satisfacción de la óptica.
model CalificacionPedido {
  id         String   @id @default(cuid())
  pedidoId   String   @unique @map("pedido_id")
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  opticaId   String?  @map("optica_id")
  optica     Optica?  @relation(fields: [opticaId], references: [id], onDelete: SetNull)
  puntaje    Int
  comentario String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([opticaId, createdAt])
  @@map("calificaciones_pedidos")
}
